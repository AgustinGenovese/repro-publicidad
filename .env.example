# Server
PORT=3000

# MongoDB (usar una URL de Atlas u otro Mongo hosteado en producción)
MONGO_URL=mongodb://127.0.0.1:27017/repro-publicidad

# Auth (cambiar en producción)
JWT_SECRET=cambiar-este-secreto
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-password

# Vercel Blob: en Vercel se inyecta BLOB_READ_WRITE_TOKEN automáticamente
# al conectar un Blob store al proyecto. Para desarrollo local: `vercel env pull`.

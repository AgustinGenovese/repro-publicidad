{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix apps/panel && npm run build --prefix apps/player",
  "outputDirectory": "public",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "express",
      "installCommand": "npm ci --prefix ../.."
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/panel/(.*)", "destination": "/panel/$1" },
    { "source": "/player/(.*)", "destination": "/player/$1" },
    { "source": "/(.*)", "destination": "/panel/index.html" }
  ]
}
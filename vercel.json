{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "express",
      "installCommand": "npm ci --prefix ../.."
    },
    "panel": {
      "root": "apps/panel",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "../../public/panel"
    },
    "player": {
      "root": "apps/player",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "../../public/player"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/panel/assets/(.*)", "dest": "/panel/assets/$1" },
    { "src": "/player/assets/(.*)", "dest": "/player/assets/$1" },
    { "src": "/panel/(.*)", "dest": "/panel/index.html" },
    { "src": "/player/(.*)", "dest": "/player/index.html" },
    { "src": "/(.*)", "dest": "/panel/index.html" }
  ]
}
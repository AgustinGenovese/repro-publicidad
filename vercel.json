{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "express",
      "installCommand": "npm ci --prefix ../.."
    },
    "panel": {
      "root": "apps/panel",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "../../public/panel"
    },
    "player": {
      "root": "apps/player",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "../../public/player"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/panel/(.*)", "destination": { "service": "panel" } },
    { "source": "/player/(.*)", "destination": { "service": "player" } },
    { "source": "/(.*)", "destination": { "service": "panel" } }
  ]
}